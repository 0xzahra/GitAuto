rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'name', 'identity', 'technical', 'brand', 'sections', 'isDeleted', 'createdAt', 'updatedAt'])
        && data.keys().size() == 9
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() <= 200
        && data.identity is map
        && data.technical is map
        && data.brand is map
        && data.sections is list
        && data.sections.size() <= 100
        && data.isDeleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectUpdate(data) {
      return data.userId == existing().userId
        && data.name is string
        && data.name.size() <= 200
        && data.identity is map
        && data.technical is map
        && data.brand is map
        && data.sections is list
        && data.sections.size() <= 100
        && data.isDeleted is bool
        && data.createdAt == existing().createdAt
        && data.updatedAt == request.time;
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid && isValidId(projectId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(projectId) 
                    && isValidProject(incoming()) 
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn() 
                    && isValidId(projectId) 
                    && existing().userId == request.auth.uid 
                    && isValidProjectUpdate(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'identity', 'technical', 'brand', 'sections', 'isDeleted', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid && isValidId(projectId);
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['userId', 'projectId', 'action', 'details', 'timestamp'])
        && data.keys().size() == 5
        && data.userId == request.auth.uid
        && data.projectId is string
        && data.projectId.size() <= 128
        && data.action is string
        && data.action.size() <= 100
        && data.details is string
        && data.details.size() <= 500
        && data.timestamp is timestamp;
    }

    match /activityLogs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid && isValidId(logId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(logId) 
                    && isValidActivityLog(incoming())
                    && incoming().timestamp == request.time
                    && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
                    && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.userId == request.auth.uid;
      allow update: if false; // Logs are immutable
      allow delete: if isSignedIn() && existing().userId == request.auth.uid && isValidId(logId);
    }
  }
}
